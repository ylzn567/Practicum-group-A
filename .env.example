# משתני docker compose. אופציונלי: העתיקו לקובץ בשם .env בשורש הריפו (הוא לא נשמר ב-git).
# בלי הקובץ הזה הכול רץ עם ברירות המחדל שבסוגריים.

# הפורט שבו נפתח האתר (8080)
FRONTEND_PORT=8080

# הפורט של ה-API לבדיקות ישירות (5000)
BACKEND_PORT=5000

# מסד נתונים חיצוני, כדי שכל הקבוצות יעבדו על אותם נתונים (למשל Atlas).
# אם משאירים ריק, נוצר מסד Mongo מקומי בתוך docker.
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/recruitment_db
